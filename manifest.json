{
  "manifest_version": 3,
  "name": "Suno WAV Recorder",
  "version": "1.0.0",
  "description": "Records the audio of a Suno tab in full quality and saves it as a WAV file.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Suno WAV Recorder",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "tabCapture",
    "offscreen",
    "downloads",
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://suno.com/*",
    "https://*.suno.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://suno.com/*",
        "https://*.suno.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
